<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/14.0.1">
  <PropertyGroup>
    <Version>1.8.0.8</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Description>A 2048 clone. Open with /a48.</Description>
    <PackageProjectUrl>https://github.com/rail2025/Aether48</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Images\icon.png" />
    <EmbeddedResource Include="Music\bgm1.mp3" />
    <EmbeddedResource Include="Music\bgm2.mp3" />
    <EmbeddedResource Include="Music\bgm3.mp3" />
    <EmbeddedResource Include="Music\bgm5.mp3" />
    <EmbeddedResource Include="Music\bgm6.mp3" />
    <EmbeddedResource Include="Music\bgm4.mp3" />
    <EmbeddedResource Include="icon.png" />
    <EmbeddedResource Include="Images\aether48title.png" />
    <Content Include="repo.json" />
    <EmbeddedResource Include="Sfx\advance.wav" />
    <EmbeddedResource Include="Sfx\pop.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
       <PackageReference Update="DotNet.ReproducibleBuilds" Version="1.2.39" />
  </ItemGroup>
</Project>
